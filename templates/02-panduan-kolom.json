  "derived_features": {
    "Today": "Dihitung dari tugas, bigDate, agenda, rutinitas dan catatan hari. Pilih prioritas melalui bintang setelah impor.",
    "Analytics": "Dihitung dari data aktivitas dan hasil; tidak memiliki baris impor tersendiri.",
    "Cari Semua": "Mencari entitas yang diimpor; tidak membutuhkan file tersendiri.",
    "Panduan": "Konten bantuan aplikasi; tidak memiliki data impor pengguna."
  },
  "audio": {
    "route": "Settings → impor ZIP audio atau unggah melalui perekam",
    "manifest": {
      "version": 1,
      "kind": "lifeos-recordings",
      "recordings": []
    },
    "note": "File audio tidak dapat dimasukkan ke JSON ini. ZIP memuat recordings.json dan file audio yang sebenarnya. Untuk arsip berisi audio, gunakan format hasil ekspor aplikasi."
  }
}
