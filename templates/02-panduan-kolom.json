        "score4",
        "decision",
        "assessor",
        "note",
        "nextReview"
      ],
      "dependencies": [],
      "example": {
        "id": "demo-check",
        "juz": 30,
        "date": "2000-01-01",
        "kind": "Penjagaan setelah jeda",
        "score0": "belum",
        "score1": "belum",
        "score2": "belum",
        "score3": "belum",
        "score4": "belum",
